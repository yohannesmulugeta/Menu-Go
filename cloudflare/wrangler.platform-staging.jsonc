{
  "name": "admaki-menu-platform-staging",
  "main": "platform/entry.mjs",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "PRIVATE_OPERATIONS", "class_name": "MenuPrivateOperations" }]
  },
  "migrations": [{ "tag": "private-operations-v1", "new_sqlite_classes": ["MenuPrivateOperations"] }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "ENVIRONMENT": "admaki-menu-platform-staging"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "admaki-menu-platform-staging",
      "database_id": "0cd21d93-da77-4b6b-b4dd-e16b741348c5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "admaki-menu-media-platform-staging"
    }
  ]
}
