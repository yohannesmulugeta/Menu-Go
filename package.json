{
  "name": "menu-go",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "python scripts/restore-media.py",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:production": "node scripts/production-check.mjs",
    "test": "node --test tests/cloudflare.test.mjs",
    "check": "npm run lint && npm test && npm run build && npm run check:production",
    "build:worker": "wrangler deploy --dry-run --outdir dist --config cloudflare/wrangler.jsonc",
    "deploy:cloudflare": "npm run build && wrangler deploy --config cloudflare/wrangler.jsonc",
    "preview": "vite preview"
  },
  "dependencies": {
    "jose": "6.2.17",
    "lucide-react": "0.544.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "wrangler": "4.159.0"
  }
}
