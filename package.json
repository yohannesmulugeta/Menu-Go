{
  "name": "menu-go",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:production": "node scripts/production-check.mjs",
    "check": "npm run lint && npm run build && npm run check:production",
    "preview": "vite preview",
    "check:cloudflare-baseline": "node scripts/check-cloudflare-baseline.mjs --test",
    "build:cloudflare-baseline": "node scripts/build-cloudflare-baseline.mjs",
    "build:cloudflare-frontend": "node scripts/build-cloudflare-frontend.mjs",
    "check:frontend-recovery": "node scripts/check-frontend-recovery.mjs",
    "check:menu-platform": "node scripts/check-menu-platform.mjs",
    "check:menu-auth": "node scripts/check-menu-auth.mjs",
    "check:menu-features": "tsc -p cloudflare/platform/tsconfig.contract.json && node scripts/check-menu-features.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "0.544.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@babel/generator": "7.29.8",
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.8",
    "@eslint/js": "9.39.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6"
  }
}
